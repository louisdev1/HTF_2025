generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Fish {
  id             Int            @id @default(autoincrement())
  name           String
  scientificName String
  description    String
  imageUrl       String
  rarity         String         @default("Common") // Common, Rare, Epic
  habitat        String
  size           String
  minDepth       Int            @default(0)
  maxDepth       Int            @default(100)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sightings      FishSighting[]
}

model FishSighting {
  id            Int      @id @default(autoincrement())
  fishId        Int
  latitude      Float
  longitude     Float
  location      String
  timestamp     DateTime @default(now())
  seen          Boolean  @default(true)
  photoUrl      String?  // Photo evidence URL
  aiConfidence  Float?   // AI confidence score (0-1)
  verified      Boolean  @default(false) // AI verified
  fish          Fish     @relation(fields: [fishId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model DivingCenter {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  region    String
  createdAt DateTime @default(now())
}
